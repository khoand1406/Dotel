@page
@model ServiceModel;
@using Dotel2.Pages.Shared

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@removeTagHelper Microsoft.AspNetCore.Mvc.TagHelpers.OptionTagHelper , Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Dotel2
@{
    Layout = "Shared/_Layout2";
}

<title>Dịch vụ</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    .service-card img {
        height: 250px;
        width: 100%;
        object-fit: cover;
        border-radius: 8px;
    }

    .carousel-item img {
        height: 250px;
        object-fit: cover;
        width: 100%;
        border-radius: 8px;
    }
</style>

<div class="container mt-5">
    <h1 class="mb-4">Dịch vụ</h1>
    <div class="accordion" id="serviceAccordion">
        <!-- Taxi Services -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingTaxi">
                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTaxi" aria-expanded="true" aria-controls="collapseTaxi">
                    🚕 Dịch vụ Taxi
                </button>
            </h2>
            <div id="collapseTaxi" class="accordion-collapse collapse show" aria-labelledby="headingTaxi" data-bs-parent="#serviceAccordion">
                <div class="accordion-body">
                    <div class="row">
                        
                        <partial name="_TaxiServicesPartial" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Laundry Services -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingLaundry">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseLaundry" aria-expanded="false" aria-controls="collapseLaundry">
                    🧺 Dịch vụ Giặt là
                </button>
            </h2>
            <div id="collapseLaundry" class="accordion-collapse collapse" aria-labelledby="headingLaundry" data-bs-parent="#serviceAccordion">
                <div class="accordion-body">
                    <div class="row">
                        <partial name="_LaundryServicesPartial" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Moving Services -->
        <div class="accordion-item">
            <h2 class="accordion-header" id="headingMove">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMove" aria-expanded="false" aria-controls="collapseMove">
                    📦 Dịch vụ Chuyển đồ
                </button>
            </h2>
            <div id="collapseMove" class="accordion-collapse collapse" aria-labelledby="headingMove" data-bs-parent="#serviceAccordion">
                <div class="accordion-body">
                    <div class="row">
                        <partial name="_MoveServicesPartial" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
